{
  "name": "remsfal-de",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vitepress dev docs --port 5174",
    "build": "NODE_ENV=production vitepress build docs",
    "preview": "NODE_ENV=development vitepress preview dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint --quiet",
    "lint:report": "mkdir -p reports && eslint --format json --output-file reports/eslint-report.json",
    "lint:fix": "eslint --fix",
    "format": "prettier --write docs/"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "markdown-it": "^15.0.0",
    "primeicons": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "tailwindcss": "^4.3.2",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true
  }
